DATABASE_URL="postgresql://lekki:lekki@localhost:5432/leos?schema=public"
RUNTIME_PORT=3000
# Comma-separated browser origins allowed to call the API (CORS). Required in production.
WEB_ORIGIN="http://localhost:4200"

# Payment connector: manual | fake | payfast
PAYMENT_CONNECTOR=manual

# Public origin of this runtime (no trailing slash). Required to derive PayFast ITN notify URL
# when PAYFAST_NOTIFY_URL is unset. Never defaults to localhost.
# PUBLIC_RUNTIME_ORIGIN=https://<your-tunnel-or-host>

# PayFast — prefer Studio vault credentials. Env overrides are optional for local PAYMENT_CONNECTOR=payfast.
# Do not ship published sandbox merchant defaults as production fallbacks.
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=
PAYFAST_BASE_URL=https://sandbox.payfast.co.za/eng/process
PAYFAST_VALIDATE_URL=https://sandbox.payfast.co.za/eng/query/validate
# Sandbox-only: set to 0 if /eng/query/validate hangs. Forbidden when NODE_ENV=production.
# PAYFAST_CONFIRM_WITH_SERVER=0
# Guest return / cancel land on the Angular PWA
PAYFAST_RETURN_URL=http://localhost:4200/guest?payment=return
PAYFAST_CANCEL_URL=http://localhost:4200/guest?payment=cancel
# ITN notify must be publicly reachable. Prefer this explicit URL, or PUBLIC_RUNTIME_ORIGIN above.
PAYFAST_NOTIFY_URL=https://<your-ngrok-id>.ngrok-free.app/payments/payfast/notify

# Required — runtime refuses to boot if unset or equal to the old published defaults
# (leos-dev-staff-token-secret / lekki-dev-vault-key). Generate your own; do not commit real values.
STAFF_TOKEN_SECRET=replace-with-a-long-random-staff-token-secret
LEKKI_VAULT_KEY=replace-with-a-long-random-vault-key
# Never set NODE_TLS_REJECT_UNAUTHORIZED=0 in production — use NODE_EXTRA_CA_CERTS instead.

# Pilot POS ingress webhook — Bearer / X-Pilot-Webhook-Token or X-Pilot-Signature HMAC.
# Required to call POST /integrations/pos/pilot/notify (16+ characters).
PILOT_POS_WEBHOOK_SECRET=replace-with-a-long-random-pilot-webhook-secret

# Dev-only: allow staff to POST /payments/:id/complete when PAYMENT_CONNECTOR=manual
LEOS_ALLOW_MANUAL_COMPLETE=1

# Studio Google sign-in — Web client ID (Google Cloud → APIs & Services → Credentials)
# Authorized JavaScript origins must include http://localhost:4200
LEOS_GOOGLE_CLIENT_ID=
# Dev-only: first Google sign-in may create an operator in the demo organisation
LEOS_GOOGLE_PROVISION=1

# Studio venue assets (local disk v1 — swap AssetStore DI for R2/S3 later)
# Absolute or relative path; default apps/runtime/.data/assets when unset
LEOS_ASSET_ROOT=
# Optional absolute public base (no trailing slash). Empty → relative /assets/... URLs
PUBLIC_ASSET_BASE_URL=

