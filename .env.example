DATABASE_URL="postgresql://lekki:lekki@localhost:5432/leos?schema=public"
RUNTIME_PORT=3000
WEB_ORIGIN="http://localhost:4200"

# Payment connector: manual | fake | payfast
PAYMENT_CONNECTOR=manual

# PayFast (Phase 2) — sandbox merchant defaults; override for your sandbox account
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
# Optional salt — set in PayFast sandbox Settings if you use a passphrase
PAYFAST_PASSPHRASE=
PAYFAST_BASE_URL=https://sandbox.payfast.co.za/eng/process
PAYFAST_VALIDATE_URL=https://sandbox.payfast.co.za/eng/query/validate
# Guest return / cancel land on the Angular PWA
PAYFAST_RETURN_URL=http://localhost:4200/guest?payment=return
PAYFAST_CANCEL_URL=http://localhost:4200/guest?payment=cancel
# ITN notify must be publicly reachable (use ngrok for local sandbox tests)
STAFF_TOKEN_SECRET=
LEKKI_VAULT_KEY=
# Dev-only: allow staff to POST /payments/:id/complete when PAYMENT_CONNECTOR=manual
LEOS_ALLOW_MANUAL_COMPLETE=1

# Studio Google sign-in — Web client ID (Google Cloud → APIs & Services → Credentials)
# Authorized JavaScript origins must include http://localhost:4200
LEOS_GOOGLE_CLIENT_ID=
# Dev-only: first Google sign-in may create an operator in the demo organisation
LEOS_GOOGLE_PROVISION=1

