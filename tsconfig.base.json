{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@lekki/contracts": ["packages/contracts/src"],
      "@lekki/shared": ["packages/shared/src"],
      "@lekki/domain": ["packages/domain/src"],
      "@lekki/profile-engine": ["packages/profile-engine/src"],
      "@lekki/runtime-entry": ["packages/runtime/entry/src"],
      "@lekki/runtime-context": ["packages/runtime/context/src"],
      "@lekki/runtime-experience": ["packages/runtime/experience/src"],
      "@lekki/runtime-capability": ["packages/runtime/capability/src"],
      "@lekki/connector-manual-payment": ["connectors/manual-payment/src"],
      "@lekki/connector-payfast": ["connectors/payfast/src"],
      "@lekki/pack-restaurant": ["packs/restaurant/src"]
    }
  }
}
